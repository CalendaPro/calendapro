'use client'

import React from 'react'
import { useLayout } from '@/lib/layout-provider'
import ModernLayout from './layouts/ModernLayout'
import ProLayout from './layouts/ProLayout'
import MinimalistLayout from './layouts/MinimalistLayout'
import CompactLayout from './layouts/CompactLayout'
import DarkProLayout from './layouts/DarkProLayout'

interface Props {
  children: React.ReactNode
  userName: string
  userEmail: string
}

export default function DashboardShell({ children, userName, userEmail }: Props) {
  const { dashboardLayout } = useLayout()

  const shared = { children, userName, userEmail }

  switch (dashboardLayout) {
    case 'pro':        return <ProLayout {...shared} />
    case 'minimalist': return <MinimalistLayout {...shared} />
    case 'compact':    return <CompactLayout {...shared} />
    case 'dark-pro':   return <DarkProLayout {...shared} />
    default:           return <ModernLayout {...shared} />
  }
}
</file>

