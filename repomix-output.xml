'use client'

import { Area, AreaChart, ResponsiveContainer, Tooltip, XAxis, YAxis, CartesianGrid } from 'recharts'

type Row = { day: string; revenue: number; rdv: number }

// Custom tooltip with modern dark design
function CustomTooltip({ active, payload, label }: { active?: boolean; payload?: Array<{value: number}>; label?: string }) {
  if (active && payload && payload.length) {
    const value = payload[0].value
    return (
      <div style={{
        background: '#0f172a',
        borderRadius: '12px',
        padding: '12px 16px',
        border: '1px solid rgba(124, 58, 237, 0.3)',
        boxShadow: '0 8px 32px rgba(0,0,0,0.3)',
      }}>
        <div style={{ color: '#94a3b8', fontSize: '0.75rem', marginBottom: '4px' }}>{label}</div>
        <div style={{ color: '#f8fafc', fontSize: '1rem', fontWeight: 600 }}>
          {value > 0 ? `${value.toLocaleString('fr-FR')} €` : 'Aucun revenu'}
        </div>
      </div>
    )
  }
  return null
}

export default function DashboardClient({ chartData }: { chartData: Row[] }) {
  const totalRevenue = chartData.reduce((sum, d) => sum + d.revenue, 0)
  const avgPerDay = totalRevenue / 7
  const hasData = totalRevenue > 0

  return (
    <div>
      {/* Stats summary */}
      <div style={{
        display: 'flex',
        gap: '24px',
        marginBottom: '20px',
        padding: '0 4px',
      }}>
        <div>
          <div style={{ fontSize: '0.75rem', color: '#64748b', marginBottom: '4px' }}>Total semaine</div>
          <div style={{ fontSize: '1.4rem', fontWeight: 700, color: '#0f172a' }}>
            {hasData ? `${totalRevenue.toLocaleString('fr-FR')} €` : '-'}
          </div>
        </div>
        <div style={{ width: '1px', background: '#e2e8f0' }} />
        <div>
          <div style={{ fontSize: '0.75rem', color: '#64748b', marginBottom: '4px' }}>Moyenne/jour</div>
          <div style={{ fontSize: '1.4rem', fontWeight: 700, color: '#0f172a' }}>
            {hasData ? `${Math.round(avgPerDay).toLocaleString('fr-FR')} €` : '-'}
          </div>
        </div>
        <div style={{ width: '1px', background: '#e2e8f0' }} />
        <div>
          <div style={{ fontSize: '0.75rem', color: '#64748b', marginBottom: '4px' }}>RDV total</div>
          <div style={{ fontSize: '1.4rem', fontWeight: 700, color: '#0f172a' }}>
            {chartData.reduce((sum, d) => sum + d.rdv, 0) || '-'}
          </div>
        </div>
      </div>

      {/* Chart */}
      <div style={{ height: 240 }}>
        {hasData ? (
          <ResponsiveContainer width="100%" height="100%">
            <AreaChart data={chartData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>
              <defs>
                <linearGradient id="colorRevenue" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor="#7c3aed" stopOpacity={0.3}/>
                  <stop offset="95%" stopColor="#7c3aed" stopOpacity={0}/>
                </linearGradient>
              </defs>
              <CartesianGrid 
                strokeDasharray="3 3" 
                vertical={false} 
                stroke="rgba(0,0,0,0.03)"
              />
              <XAxis 
                dataKey="day" 
                tick={{ fontSize: 12, fill: '#64748b' }} 
                axisLine={false}
                tickLine={false}
                dy={10}
              />
              <YAxis 
                tick={{ fontSize: 11, fill: '#94a3b8' }} 
                axisLine={false}
                tickLine={false}
                tickFormatter={(value) => `${value}€`}
                dx={-10}
              />
              <Tooltip content={<CustomTooltip />} />
              <Area 
                type="monotone" 
                dataKey="revenue" 
                stroke="#7c3aed" 
                strokeWidth={2.5}
                fill="url(#colorRevenue)"
                animationDuration={1500}
                animationEasing="ease-out"
              />
            </AreaChart>
          </ResponsiveContainer>
        ) : (
          <div style={{
            height: '100%',
            display: 'flex',
            flexDirection: 'column',
            alignItems: 'center',
            justifyContent: 'center',
            color: '#94a3b8',
            gap: '12px',
          }}>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
              <line x1="18" y1="20" x2="18" y2="10"/>
              <line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/>
              <line x1="2" y1="20" x2="22" y2="20"/>
            </svg>
            <div style={{ fontSize: '0.9rem' }}>Aucune donnée cette semaine</div>
            <div style={{ fontSize: '0.75rem', opacity: 0.7 }}>Les revenus apparaîtront ici</div>
          </div>
        )}
      </div>
    </div>
  )
}
