        setEvents(prev => prev.map(e => e.id === localId ? { ...e, status: validationType } : e))
      }
    } catch (err) {
      console.error('[Calendar] Complete error:', err)
    }
  }, [sidebarId])
  
  // Fonction pour réessayer après une erreur
  const handleRetrySync = () => {
