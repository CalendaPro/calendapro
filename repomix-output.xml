'use client'

import { useLayout } from '@/lib/layout-provider'

interface StatCardsProps {
  todayCount: number
  weekCount: number
  clientsCount: number
  pendingCount: number
  revenue?: number
  revenueChange?: number
}

// Icon components
const CalendarIcon = () => (
