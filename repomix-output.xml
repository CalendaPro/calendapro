          <span style={{ fontSize: '0.64rem', padding: '0.13rem 0.5rem', borderRadius: 100, background: 'var(--cl-accent-soft)', color: 'var(--cl-accent)', border: '1px solid var(--cl-accent-20)', fontWeight: 600, fontFamily: "'DM Sans', sans-serif" }}>
