          ? '0 12px 32px rgba(124,58,237,0.12)'
          : popular ? '0 4px 20px rgba(124,58,237,0.1)' : 'none',
      }}
    >
      {popular && (
        <div style={{
          position: 'absolute', top: -11, left: '50%', transform: 'translateX(-50%)',
          background: 'linear-gradient(135deg, #7c3aed, #ec4899)',
