          <div>
            <div style={{
              fontSize: '1.1rem',
              fontWeight: 700,
              color: '#0f172a',
              lineHeight: 1.2,
            }}>
              {stat.value}
            </div>
            <div style={{
              fontSize: '0.7rem',
              color: '#64748b',
            }}>
              {stat.label}
            </div>
          </div>
        </div>
      ))}
    </div>
  )
}
