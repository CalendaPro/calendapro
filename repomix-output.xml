  try {
    // Utiliser la fonction SQL pour sauvegarder l'étape
    const { data, error } = await supabase.rpc('save_onboarding_step', {
      p_user_id: userId,
      p_step: step,
      p_step_data: stepData,
      p_is_completed: isCompleted,
