import { auth } from '@clerk/nextjs/server'
import { NextResponse } from 'next/server'
import { createServerSupabaseClient } from '@/lib/supabase-server'
import { DEFAULT_THEME_ID, getAllThemeIds } from '@/lib/themes-complete'

export async function GET() {
  const { userId } = await auth()
  if (!userId) return NextResponse.json({ error: 'Non autorisé' }, { status: 401 })

  const supabase = createServerSupabaseClient()
  const { data } = await supabase
    .from('profiles')
    .select('theme_mode, accent_color_override, pro_layout, client_layout, theme_pack_id')
    .eq('id', userId)
    .maybeSingle()

  // Validate theme_pack_id
  const validThemeIds = getAllThemeIds()
  const themePackId = data?.theme_pack_id && validThemeIds.includes(data.theme_pack_id)
    ? data.theme_pack_id
    : DEFAULT_THEME_ID

  return NextResponse.json({
    theme_mode: data?.theme_mode ?? 'auto',
    accent_color_override: data?.accent_color_override ?? null,
    pro_layout: data?.pro_layout ?? 'modern',
    client_layout: data?.client_layout ?? 'modern',
    theme_pack_id: themePackId,
  })
}

export async function PATCH(req: Request) {
  const { userId } = await auth()
  if (!userId) return NextResponse.json({ error: 'Non autorisé' }, { status: 401 })

  const body = (await req.json().catch(() => ({}))) as {
    theme_mode?: string
    accent_color_override?: string | null
    pro_layout?: string
    client_layout?: string
    theme_pack_id?: string
  }

  const updates: Record<string, unknown> = {}

  if (body.theme_mode !== undefined) {
    if (!['light', 'dark', 'auto'].includes(body.theme_mode)) {
      return NextResponse.json({ error: 'Valeur invalide pour theme_mode' }, { status: 400 })
    }
    updates.theme_mode = body.theme_mode
  }

  if ('accent_color_override' in body) {
    updates.accent_color_override = body.accent_color_override ?? null
  }

  const VALID_PRO_LAYOUTS = ['modern', 'pro', 'minimalist', 'compact', 'dark-pro']
  const VALID_CLIENT_LAYOUTS = ['modern', 'pro', 'minimalist', 'compact', 'dark']

  if (body.pro_layout !== undefined) {
    if (!VALID_PRO_LAYOUTS.includes(body.pro_layout)) {
      return NextResponse.json({ error: 'Valeur invalide pour pro_layout' }, { status: 400 })
    }
    updates.pro_layout = body.pro_layout
  }

  if (body.client_layout !== undefined) {
    if (!VALID_CLIENT_LAYOUTS.includes(body.client_layout)) {
      return NextResponse.json({ error: 'Valeur invalide pour client_layout' }, { status: 400 })
    }
    updates.client_layout = body.client_layout
  }

  // Validate theme_pack_id
  if (body.theme_pack_id !== undefined) {
    const validThemeIds = getAllThemeIds()
    if (!validThemeIds.includes(body.theme_pack_id)) {
      return NextResponse.json({ error: 'Valeur invalide pour theme_pack_id' }, { status: 400 })
    }
    updates.theme_pack_id = body.theme_pack_id
  }

  if (Object.keys(updates).length === 0) {
    return NextResponse.json({ ok: true })
  }

  const supabase = createServerSupabaseClient()
  const { error } = await supabase
    .from('profiles')
    .update(updates)
    .eq('id', userId)

  if (error) {
    console.error('[preferences PATCH]', error)
    return NextResponse.json({ error: error.message }, { status: 500 })
  }

  return NextResponse.json({ ok: true })
}
