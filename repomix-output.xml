    colors: ['#7c3aed', '#06b6d4', '#f59e0b'],
    accent: '#7c3aed',
    previewBg: 'linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%)',
    idealFor: 'Tech, dev, gaming'
  }
