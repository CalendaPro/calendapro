          <div style={{ padding: '0.85rem 1.2rem', background: PAYMENT_STATUS_CONFIG.pending.bg, border: `1px solid ${PAYMENT_STATUS_CONFIG.pending.border}`, borderRadius: 10, marginTop: '0.85rem' }}>
