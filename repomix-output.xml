<file path="lib/layout-provider.tsx">
'use client'

import React, { createContext, useCallback, useContext, useEffect, useState } from 'react'
import {
  PRO_LAYOUTS, CLIENT_LAYOUTS,
  getProLayout, getClientLayout,
  type ProLayoutId, type ClientLayoutId,
} from './layouts'

export type DashboardLayoutId = 'modern' | 'pro' | 'minimalist' | 'compact' | 'dark-pro'

interface LayoutContextValue {
  proLayout: ProLayoutId
  clientLayout: ClientLayoutId
  dashboardLayout: DashboardLayoutId
  setProLayout: (id: ProLayoutId) => void
  setClientLayout: (id: ClientLayoutId) => void
  setDashboardLayout: (id: DashboardLayoutId) => void
  isLoading: boolean
}

const LayoutContext = createContext<LayoutContextValue>({
  proLayout: 'modern',
  clientLayout: 'modern',
  dashboardLayout: 'modern',
  setProLayout: () => {},
  setClientLayout: () => {},
  setDashboardLayout: () => {},
  isLoading: true,
})

export function useLayout() {
  return useContext(LayoutContext)
}

// All CSS var names that layout system manages (union of all layout vars)
const ALL_PRO_VARS = [...new Set(
  Object.values(PRO_LAYOUTS).flatMap(l => Object.keys(l.vars))
)]
const ALL_CLIENT_VARS = [...new Set(
  Object.values(CLIENT_LAYOUTS).flatMap(l => Object.keys(l.vars))
)]

function applyLayoutVars(vars: Record<string, string>) {
  if (typeof document === 'undefined') return
  const root = document.documentElement
  for (const [k, v] of Object.entries(vars)) {
    root.style.setProperty(k, v)
  }
}

function clearVars(names: string[]) {
  if (typeof document === 'undefined') return
  const root = document.documentElement
  for (const name of names) {
    root.style.removeProperty(name)
  }
}

function applyProLayout(id: ProLayoutId) {
  const layout = getProLayout(id)
  // Clear all managed vars first so defaults take over for missing ones
  clearVars(ALL_PRO_VARS)
  applyLayoutVars(layout.vars)
  // Handle dark-pro forced dark mode
  const root = document.documentElement
  if (layout.forceDark) {
    root.setAttribute('data-layout-forced-dark', 'true')
    root.classList.add('dark')
    root.setAttribute('data-theme', 'dark')
  } else {
    root.removeAttribute('data-layout-forced-dark')
    // Restore from localStorage preference
    try {
      const saved = localStorage.getItem('cp-theme-mode')
      const sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      const active = (saved === 'dark' || saved === 'light') ? saved : sys
      if (active === 'dark') {
        root.classList.add('dark')
        root.setAttribute('data-theme', 'dark')
      } else {
        root.classList.remove('dark')
        root.setAttribute('data-theme', 'light')
      }
    } catch {}
  }
  // Mark density on html element
  if (layout.density === 'compact') {
    root.setAttribute('data-pro-density', 'compact')
  } else {
    root.removeAttribute('data-pro-density')
  }
}

function applyClientLayout(id: ClientLayoutId) {
  const layout = getClientLayout(id)
  clearVars(ALL_CLIENT_VARS)
  applyLayoutVars(layout.vars)
  if (layout.density === 'compact') {
    document.documentElement.setAttribute('data-cl-density', 'compact')
  } else {
    document.documentElement.removeAttribute('data-cl-density')
  }
}

export function LayoutProvider({ children }: { children: React.ReactNode }) {
  const [proLayout, setProLayoutState] = useState<ProLayoutId>('modern')
  const [clientLayout, setClientLayoutState] = useState<ClientLayoutId>('modern')
  const [dashboardLayout, setDashboardLayoutState] = useState<DashboardLayoutId>('modern')
  const [isLoading, setIsLoading] = useState(true)

  // Load from API on mount
  useEffect(() => {
    fetch('/api/user/preferences')
      .then(r => r.json())
      .then((d: { pro_layout?: string; client_layout?: string }) => {
        const raw = d.pro_layout || 'modern'
        const pl = (raw as ProLayoutId)
        const dl = (raw as DashboardLayoutId)
        const cl = (d.client_layout as ClientLayoutId) || 'modern'
        setProLayoutState(pl)
        setDashboardLayoutState(dl)
        setClientLayoutState(cl)
        applyProLayout(pl)
        applyClientLayout(cl)
        setIsLoading(false)
      })
      .catch(() => {
        applyProLayout('modern')
        applyClientLayout('modern')
        setIsLoading(false)
      })
  }, [])

  const setProLayout = useCallback((id: ProLayoutId) => {
    setProLayoutState(id)
    applyProLayout(id)
    fetch('/api/user/preferences', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pro_layout: id }),
    }).catch(() => {})
  }, [])

  const setClientLayout = useCallback((id: ClientLayoutId) => {
    setClientLayoutState(id)
    applyClientLayout(id)
    fetch('/api/user/preferences', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ client_layout: id }),
    }).catch(() => {})
  }, [])

  const setDashboardLayout = useCallback((id: DashboardLayoutId) => {
    setDashboardLayoutState(id)
    applyProLayout(id as ProLayoutId)
    fetch('/api/user/preferences', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pro_layout: id }),
    }).catch(() => {})
  }, [])

  return (
    <LayoutContext.Provider value={{
      proLayout, clientLayout, dashboardLayout,
      setProLayout, setClientLayout, setDashboardLayout,
      isLoading
    }}>
      {children}
    </LayoutContext.Provider>
  )
}
</file>

