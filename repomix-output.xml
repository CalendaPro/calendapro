          font-family: 'IBM Plex Mono', monospace;
          font-size: 0.7rem; font-weight: 500;
          color: #0f172a; letter-spacing: 0.04em;
          padding: 2px 8px;
          background: #f1f5f9; border: 1px solid #e2e8f0;
          border-radius: 3px; flex-shrink: 0;
