}

// Configuration des statuts
const STATUS_CONFIG = {
  upcoming:  { label: 'Confirmé',  bg: '#EFF6FF', text: '#1D4ED8', border: '#BFDBFE', dot: '#3B82F6', icon: <CheckCircle2 size={12} strokeWidth={2} /> },
