                cursor: saving || isLoading ? 'wait' : 'pointer',
                transition: 'all 0.18s ease',
                overflow: 'hidden',
                position: 'relative',
                padding: 0,
                textAlign: 'left',
                opacity: saving && !isActive ? 0.6 : 1,
              }}
            >
              {/* Preview */}
              <div style={{ 
                height: 80, 
                background: theme.previewBg,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                gap: 8,
                padding: '0 16px',
              }}>
                {/* Mini layout preview */}
                <div style={{
                  width: 60,
