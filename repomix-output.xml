          <h3 style={{ fontFamily: "'Clash Display', sans-serif", fontSize: '1.1rem', fontWeight: 700, color: 'var(--cl-text-primary)' }}>
            {activeTab === 'upcoming' ? 'Aucun rendez-vous à venir' : 'Aucun historique'}
          </h3>
          <p style={{ fontFamily: "'DM Sans', sans-serif", color: 'var(--cl-text-muted)', fontSize: '0.85rem', maxWidth: 320, lineHeight: 1.65 }}>
            {activeTab === 'upcoming' ? 'Prenez rendez-vous avec un professionnel sur la Marketplace.' : 'Vos rendez-vous passés apparaîtront ici.'}
          </p>
          {activeTab === 'upcoming' && (
            <Link
              href="/client/marketplace"
              className="btn-glow"
              style={{ display: 'inline-flex', alignItems: 'center', gap: 6, padding: '0.6rem 1.4rem', background: 'linear-gradient(135deg, #4F46E5, #6366f1)', color: 'white', borderRadius: 12, fontSize: '0.82rem', fontWeight: 700, textDecoration: 'none', fontFamily: "'DM Sans', sans-serif", boxShadow: '0 4px 16px rgba(79,70,229,0.2)' }}
            >
              Trouver un professionnel
              <ArrowRight size={14} strokeWidth={2.5} />
            </Link>
          )}
        </div>
      ) : (
        <div style={{ display: 'grid', gap: '1rem', gridTemplateColumns: 'repeat(auto-fill, minmax(300px, 1fr))' }}>
          {sorted.map(booking => (
            <AppointmentCard
              key={booking.id}
              booking={booking}
              onCancel={(b, c) => setCancelModal({ open: true, booking: b, check: c })}
            />
          ))}
        </div>
      )}

      {/* Modal */}
      {cancelModal.open && cancelModal.booking && cancelModal.check && (
        <CancelModal
          booking={cancelModal.booking}
          cancelCheck={cancelModal.check}
          onConfirm={handleCancel}
          onClose={() => setCancelModal({ open: false, booking: null, check: null })}
          isLoading={cancelling}
        />
      )}
    </div>
  )
}
