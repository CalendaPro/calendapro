                }}>
                  {theme.description}
                </p>
                
                <p style={{
                  fontSize: '0.65rem',
                  color: 'var(--dl-text-muted, #64748b)',
                  margin: 0,
                  fontFamily: 'DM Sans, sans-serif',
                  fontStyle: 'italic'
                }}>
                  Ideal pour: {theme.idealFor}
                </p>
              </div>

              {/* Active indicator */}
              {isActive && (
                <div style={{
                  position: 'absolute',
                  top: 8,
                  right: 8,
                  width: 10,
                  height: 10,
                  borderRadius: '50%',
                  background: theme.accent,
                  boxShadow: '0 0 0 2px white',
                }} />
              )}
            </button>
          )
        })}
      </div>

      {/* Accent Color Selection */}
      <div style={{ marginBottom: 20 }}>
        <h4 style={{ 
          fontSize: '0.8rem', 
