# =============================================================================
# CalendaPro - Environment variables
# Copy this file to .env.local for development, configure on Vercel for prod.
# =============================================================================

# -------- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: secret used to authorize internal cron endpoints
CRON_SECRET=
# Optional: secret used to authorize internal-to-internal API calls
INTERNAL_API_SECRET=
# Optional: Google Search Console verification meta tag value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -------- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------- Clerk (authentication) ---------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# -------- Stripe -------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Subscription price IDs (public + server-side mirrors used in webhooks)
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=
NEXT_PUBLIC_STRIPE_INFINITY_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_INFINITY_PRICE_ID=

# SMS top-up packs
NEXT_PUBLIC_STRIPE_SMS_50_PRICE_ID=
NEXT_PUBLIC_STRIPE_SMS_200_PRICE_ID=
NEXT_PUBLIC_STRIPE_SMS_500_PRICE_ID=

# -------- Twilio (SMS) -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -------- Resend (transactional email) ---------------------------------------
RESEND_API_KEY=

# -------- Google Calendar integration ----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------- AI (optional, used by AI bio / IG post generators) -----------------
ANTHROPIC_API_KEY=
