# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/
.aidesigner/*
!.aidesigner/.gitkeep

!.env.example

# binaries
*.exe

# large/generated audit files
repomix-output.xml
full-project-audit.txt
full-project-lean.txt
ultra-lean-project.txt
pricing-test.html
post-correction-audit.txt

# playwright
/playwright-report/
/test-results/

# audit report files
AUDIT_*.md
*_AUDIT*.md
HEALTH_REPORT.md
LAUNCH_CHECKLIST.md
PRODUCTION_CHECKLIST.md
ENVIRONMENT_VARIABLES.md
SECURITY_AUDIT_REPORT.md
PERFORMANCE_AUDIT_*.md
