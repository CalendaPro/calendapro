              transition: 'color 0.2s',
            }}
              onMouseEnter={e => e.currentTarget.style.color = '#7c3aed'}
              onMouseLeave={e => e.currentTarget.style.color = '#94a3b8'}
            >
              Connexion
            </Link>
            <Link href="/client-sign-up" style={{
              fontSize: '0.85rem',
              color: '#7c3aed',
              fontWeight: 600,
              textDecoration: 'none',
              fontFamily: "'DM Sans', sans-serif",
            }}>
              M&apos;inscrire
